{
  "name": "expressjs-ddd",
  "version": "1.0.0",
  "description": "Express + TypeScript + Sequelize (PostgreSQL) starter organised with domain-driven design",
  "main": "dist/server.js",
  "bin": {
    "expressjs-ddd": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "migration:generate": "sequelize-cli migration:generate --name",
    "model:generate": "sequelize-cli model:generate --name",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "phambinh217",
  "license": "MIT",
  "dependencies": {
    "@vinejs/vine": "^4.4.0",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phambinh217/expressjs-ddd.git"
  },
  "engines": {
    "node": ">=18.18"
  }
}
